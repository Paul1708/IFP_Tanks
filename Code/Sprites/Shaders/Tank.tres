code = "shader_type canvas_item;
render_mode blend_mix;

uniform float Weight : hint_range(0, 1);



void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// FloatParameter:7
	float n_out7p0 = Weight;


// VectorCompose:6
	vec4 n_out6p0 = vec4(n_out7p0, n_out7p0, n_out7p0, n_out7p0);


// Mix:4
	vec4 n_in4p1 = vec4(1.00000, 1.00000, 1.00000, 1.00000);
	vec4 n_out4p0 = mix(n_out2p0, n_in4p1, n_out6p0);


// Output:0
	COLOR.rgb = vec3(n_out4p0.xyz);


}
"
