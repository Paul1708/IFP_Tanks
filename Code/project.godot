; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Code"
run/main_scene="res://Scenes/main_menu.tscn"
config/features=PackedStringArray("4.2", "C#", "Mobile")
config/icon="res://Sprites/icon.svg"

[autoload]

MusicController="*res://Scenes/MusicController.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Code"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")

[file_customization]

folder_colors={
"res://Scenes/": "yellow",
"res://Scripts/": "red",
"res://Sprites/": "blue",
"res://Test/": "green"
}

[gdunit4]

settings/test/test_lookup_folder="Test"
ui/toolbar/run_overall=true

